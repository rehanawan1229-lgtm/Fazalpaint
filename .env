# Local backend dev server configuration
# FIX: this must NOT be 5173 — that port is already used by the Vite
# frontend (see vite.config.js, server.port). Using the same port for
# both caused "Port 5173 is already in use" errors and made /api/*
# requests hit Vite itself (which has no such routes) -> 500 errors.
ORDER_SERVER_PORT=5001
# FIX: leave these BLANK. When blank, the frontend calls relative paths
# like "/api/..." which Vite's dev proxy (vite.config.js) forwards to the
# backend automatically — this works correctly whether you open the site
# from this computer OR from a phone on the same WiFi. Setting these to
# "http://127.0.0.1:5173" (as before) breaks mobile access, because
# 127.0.0.1 on a PHONE means the phone itself, not this computer.
VITE_API_URL=
VITE_ORDER_SERVER_URL=


# Optional: "Ask Fazal" AI chat widget upgrade (leave blank to use built-in rule-based assistant)
ANTHROPIC_API_KEY=
