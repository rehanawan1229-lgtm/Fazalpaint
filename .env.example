# =====================================================================
# FAZAL PAINT HARDWARE - ENVIRONMENT VALUES (TEMPLATE, NO REAL SECRETS)
# Fill in the values after the "=" sign. Never share this file once filled.
#   - Local computer : save the filled copy as a file named  .env  in the project root
#   - Render         : add each BACKEND line under  Environment  in the Render dashboard
#   - Vercel         : add each FRONTEND line under  Settings > Environment Variables
# =====================================================================


# ---------------------------------------------------------------------
# BACKEND  (goes in Render)
# ---------------------------------------------------------------------

# Server basics
ORDER_SERVER_PORT=3001
JWT_SECRET=PUT_A_LONG_RANDOM_TEXT_HERE
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- EMAIL: Gmail API (recommended; works on Render free) -------------
# These three make emails go out from your Gmail account over HTTPS.
# The Gmail account that approves the token is the "From" address,
# so approve it with fazalpainthardware@gmail.com.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Address customers see (and reply to) on order-status emails.
# Use the Gmail account you approved the token with.
CUSTOMER_EMAIL_FROM=fazalpainthardware@gmail.com
# ONE inbox that receives everything for the shop: new orders, logins/signups,
# bulk-order (quotation) requests and support tickets.
NOTIFICATION_EMAIL=fornotificationofwebsite@gmail.com

# --- EMAIL: other options (use ONLY if you do not use Gmail API) ------
# Brevo (HTTPS API, also works on Render free)
BREVO_API_KEY=
SMTP_FROM=
# Plain SMTP (does NOT work on Render free: ports 25/465/587 are blocked)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: order confirmation call / WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
PUBLIC_BASE_URL=https://fazalpaint-backend.onrender.com
IVR_AUDIO_URL=

# Optional: "Ask Fazal" AI chat answers
ANTHROPIC_API_KEY=


# ---------------------------------------------------------------------
# FRONTEND  (goes in Vercel)
# ---------------------------------------------------------------------
VITE_API_URL=https://fazalpaint-backend.onrender.com
VITE_ORDER_SERVER_URL=https://fazalpaint-backend.onrender.com
VITE_GOOGLE_CLIENT_ID=
VITE_WHATSAPP_NUMBER=923429085556
VITE_SHOP_ORDER_EMAIL=fazalpainthardware@gmail.com
