# Shop order email and WhatsApp number
VITE_SHOP_ORDER_EMAIL=owner@example.com
VITE_WHATSAPP_NUMBER=923001234567

# EmailJS credentials (optional if using EmailJS client-side)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Optional: "Ask Fazal" AI chat widget. Without this key, the assistant
# still works (rule-based stock lookups + shop info). Add a key from
# https://console.anthropic.com to upgrade it to full free-text AI answers.
ANTHROPIC_API_KEY=

# Google Sign-In. This project uses Google Identity Services (client-side
# ID-token flow) — only the Client ID is needed. Client Secret and
# redirect URIs are NOT used here (those are for a different OAuth flow).
# In Google Cloud Console, add your dev/production URLs under
# "Authorized JavaScript origins" (e.g. http://localhost:5173), not
# "Authorized redirect URIs".
VITE_GOOGLE_CLIENT_ID=

# Optional: automated order confirmation (IVR phone call) and WhatsApp
# order messages via Twilio. Without these, orders still save normally —
# the call/message step is skipped and logged instead.
# 1. Sign up at https://www.twilio.com, buy a phone number with Voice
#    capability for TWILIO_VOICE_NUMBER.
# 2. For WhatsApp, join/set up the Twilio WhatsApp sandbox (or a fully
#    approved WhatsApp Business sender for production) for
#    TWILIO_WHATSAPP_NUMBER.
# 3. PUBLIC_BASE_URL must be a URL Twilio's servers can reach — your real
#    domain in production, or an ngrok URL while testing locally.
#    localhost will NOT work here.
# 4. Optional: record a real human voice saying the confirmation script and
#    host the file (mp3/wav) anywhere public; set IVR_AUDIO_URL to it.
#    Without it, a text-to-speech voice is used, which does not have a
#    natural Urdu voice and may mispronounce Roman Urdu text.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
PUBLIC_BASE_URL=
IVR_AUDIO_URL=
